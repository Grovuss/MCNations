rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, then
// click "Publish". See README.md for full setup context.
//
// Design:
// - config/home is publicly readable (the homepage's Monthly Creator
//   section reads it, unauthenticated) but only writable by the admin.
// - referrals/* is NOT readable by regular clients at all — the public
//   /c/<slug> redirect is handled by a server-side function using the
//   Firebase Admin SDK, which bypasses these rules entirely. Only the
//   admin dashboard (signed in, with the admin custom claim) can read
//   or write referrals directly.
// - referrals/*/hits/* (used for unique-visitor dedup) is never read or
//   written by any client — only the server-side redirect function.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /config/home {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals/{slug} {
      allow read, write: if isAdmin();

      match /hits/{hitId} {
        allow read, write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
